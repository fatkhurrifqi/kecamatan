<%- include('../partials/header', { title: title }) %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-xl font-bold">Data Penduduk</h1>
  <a href="/penduduk/baru" class="bg-slate-900 text-white text-sm px-4 py-2 rounded hover:bg-slate-800">+ Tambah</a>
</div>
<form method="GET" class="mb-4"><input name="q" value="<%= q %>" placeholder="Cari nama / NIK..." class="border rounded px-3 py-2 text-sm w-72" /></form>
<div class="card p-4 overflow-x-auto">
  <table class="tbl">
    <thead><tr><th>NIK</th><th>Nama</th><th>Alamat</th><th>RT/RW</th><th>No. HP</th><th></th></tr></thead>
    <tbody>
      <% list.forEach(p => { %>
      <tr>
        <td><%= p.nik %></td><td><%= p.nama %></td><td><%= p.alamat %></td><td><%= p.rt_rw %></td><td><%= p.no_hp %></td>
        <td class="whitespace-nowrap">
          <a href="/penduduk/<%= p.id %>/edit" class="text-blue-600 text-xs mr-3">Edit</a>
          <% if (currentUser.role === 'superadmin') { %>
          <form action="/penduduk/<%= p.id %>/hapus" method="POST" class="inline" onsubmit="return confirm('Hapus data ini?')">
            <button class="text-red-600 text-xs">Hapus</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (list.length === 0) { %><tr><td colspan="6" class="text-center text-slate-400 py-4">Belum ada data</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
