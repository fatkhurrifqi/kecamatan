<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title + ' - SIM Kecamatan' : 'SIM Kecamatan' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="bg-slate-100 text-slate-800 min-h-screen">
    <% if (currentUser) { %>
    <div class="flex min-h-screen">
      <aside class="w-64 bg-slate-900 text-slate-100 flex-shrink-0 hidden md:flex md:flex-col">
        <div class="sidebar-brand">
          <div class="flex items-center gap-3">
            <div class="sidebar-brand-mark">🏛</div>
            <div>
              <div class="font-bold text-base leading-tight">SIM Kecamatan</div>
              <div class="text-[11px] text-slate-400">Pelayanan & Keuangan</div>
            </div>
          </div>
        </div>

        <nav class="sidebar-nav flex-1">
          <a href="/">🏠 Dashboard</a>
          <div class="nav-label">Pelayanan</div>
          <a href="/permohonan">📄 Permohonan Surat</a>
          <a href="/jenis-layanan">🗂️ Jenis Layanan</a>
          <a href="/penduduk">👥 Data Penduduk</a>
          <a href="/pengaduan">📢 Pengaduan</a>

          <div class="nav-label">Keuangan</div>
          <a href="/pembayaran">💵 Riwayat Pembayaran</a>
          <% if (['superadmin','bendahara'].includes(currentUser.role)) { %>
          <a href="/laporan">📊 Laporan / Rekap Kas</a>
          <% } %>
          <% if (currentUser.role === 'superadmin') { %>
          <div class="nav-label">Admin</div>
          <a href="/log-aktivitas">🕒 Log Aktivitas</a>
          <% } %>
        </nav>

        <div class="sidebar-user">
          <div class="font-semibold"><%= currentUser.nama %></div>
          <div class="role"><%= currentUser.role %></div>
          <form action="/logout" method="POST" class="mt-3">
            <button type="submit" class="btn-ghost text-red-400 hover:text-red-300 w-full">Keluar</button>
          </form>
        </div>
      </aside>

      <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white/80 backdrop-blur-sm border-b border-slate-200 px-4 py-3 flex items-center justify-between md:hidden">
          <div class="font-bold text-slate-800">SIM Kecamatan</div>
          <form action="/logout" method="POST"><button type="submit" class="btn-ghost text-sm text-red-600">Keluar</button></form>
        </header>

        <main class="flex-1 p-4 md:p-8">
          <div class="w-full max-w-7xl mx-auto">
            <% if (flashMsg) { %>
            <div class="mb-4 px-4 py-3 rounded-xl text-sm <%= flashMsg.type === 'error' ? 'bg-red-100 text-red-700 border border-red-300' : 'bg-green-100 text-green-700 border border-green-300' %>"><%= flashMsg.message %></div>
            <% } %>
    <% } else { %>
    <main class="min-h-screen flex items-center justify-center p-4 w-full">
    <% } %>
        </main>
      </div>
    </div>
  </body>
</html>
