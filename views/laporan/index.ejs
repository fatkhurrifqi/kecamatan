<%- include('../partials/header', { title: title }) %>
<h1 class="text-xl font-bold mb-4">Laporan & Rekap Kas</h1>

<form method="GET" class="card p-4 mb-4 flex flex-wrap gap-3 items-end">
  <div><label class="block text-xs mb-1">Dari Tanggal</label><input type="date" name="dari" value="<%= filter.dari %>" class="border rounded px-3 py-2 text-sm" /></div>
  <div><label class="block text-xs mb-1">Sampai Tanggal</label><input type="date" name="sampai" value="<%= filter.sampai %>" class="border rounded px-3 py-2 text-sm" /></div>
  <button class="bg-slate-200 px-4 py-2 rounded text-sm">Terapkan</button>
  <a href="/laporan" class="text-sm text-slate-500">Reset</a>
  <a href="/laporan/export?dari=<%= filter.dari %>&sampai=<%= filter.sampai %>" class="ml-auto bg-green-600 text-white px-4 py-2 rounded text-sm hover:bg-green-700">⬇️ Export Excel</a>
</form>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4"><div class="text-xs text-slate-500">Total Kas Masuk (Lunas)</div><div class="text-xl font-bold text-green-700">Rp <%= totalKas.toLocaleString('id-ID') %></div></div>
  <div class="card p-4"><div class="text-xs text-slate-500">Total Tunai</div><div class="text-xl font-bold">Rp <%= totalTunai.toLocaleString('id-ID') %></div></div>
  <div class="card p-4"><div class="text-xs text-slate-500">Total Transfer</div><div class="text-xl font-bold">Rp <%= totalTransfer.toLocaleString('id-ID') %></div></div>
  <div class="card p-4"><div class="text-xs text-slate-500">Jumlah Transaksi Lunas</div><div class="text-xl font-bold"><%= jumlahTransaksi %></div></div>
</div>

<div class="grid md:grid-cols-2 gap-4 mb-6">
  <div class="card p-5">
    <div class="font-semibold mb-3 text-sm">Pemasukan per Jenis Layanan</div>
    <table class="tbl">
      <% Object.entries(perJenis).forEach(([k,v]) => { %>
        <tr><td><%= k %></td><td class="text-right">Rp <%= v.toLocaleString('id-ID') %></td></tr>
      <% }) %>
      <% if (Object.keys(perJenis).length === 0) { %><tr><td class="text-slate-400 py-3">Belum ada data</td></tr><% } %>
    </table>
  </div>
  <div class="card p-5">
    <div class="font-semibold mb-3 text-sm">Pemasukan per Petugas</div>
    <table class="tbl">
      <% Object.entries(perPetugas).forEach(([k,v]) => { %>
        <tr><td><%= k %></td><td class="text-right">Rp <%= v.toLocaleString('id-ID') %></td></tr>
      <% }) %>
      <% if (Object.keys(perPetugas).length === 0) { %><tr><td class="text-slate-400 py-3">Belum ada data</td></tr><% } %>
    </table>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-4">
  <div class="card p-5">
    <div class="font-semibold mb-3 text-sm">Rekap Kas per Hari</div>
    <table class="tbl">
      <% Object.entries(perHari).sort((a,b)=>b[0].localeCompare(a[0])).forEach(([k,v]) => { %>
        <tr><td><%= new Date(k).toLocaleDateString('id-ID') %></td><td class="text-right">Rp <%= v.toLocaleString('id-ID') %></td></tr>
      <% }) %>
      <% if (Object.keys(perHari).length === 0) { %><tr><td class="text-slate-400 py-3">Belum ada data</td></tr><% } %>
    </table>
  </div>
  <div class="card p-5">
    <div class="font-semibold mb-3 text-sm">Jumlah Permohonan per Status</div>
    <table class="tbl">
      <% Object.entries(rekapPermohonan).forEach(([k,v]) => { %>
        <tr><td class="capitalize"><%= k %></td><td class="text-right"><%= v %></td></tr>
      <% }) %>
      <% if (Object.keys(rekapPermohonan).length === 0) { %><tr><td class="text-slate-400 py-3">Belum ada data</td></tr><% } %>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
