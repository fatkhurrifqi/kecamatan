<%- include('../partials/header', { title: title }) %>
<h1 class="text-xl font-bold mb-4">Log Aktivitas (Audit Trail)</h1>
<div class="card p-4 overflow-x-auto">
  <table class="tbl">
    <thead><tr><th>Waktu</th><th>User</th><th>Aksi</th><th>Tabel</th><th>Detail</th></tr></thead>
    <tbody>
      <% list.forEach(l => { %>
      <tr>
        <td><%= new Date(l.waktu).toLocaleString('id-ID') %></td>
        <td><%= l.user_nama %></td>
        <td class="capitalize"><%= l.aksi %></td>
        <td><%= l.tabel_terkait %> #<%= l.data_id %></td>
        <td><%= l.detail %></td>
      </tr>
      <% }) %>
      <% if (list.length === 0) { %><tr><td colspan="5" class="text-center text-slate-400 py-4">Belum ada log</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
