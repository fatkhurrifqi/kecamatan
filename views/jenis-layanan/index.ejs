<%- include('../partials/header', { title: title }) %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-xl font-bold">Jenis Layanan / Surat</h1>
  <% if (['superadmin','petugas'].includes(currentUser.role)) { %>
  <a href="/jenis-layanan/baru" class="bg-slate-900 text-white text-sm px-4 py-2 rounded hover:bg-slate-800">+ Tambah</a>
  <% } %>
</div>
<div class="card p-4 overflow-x-auto">
  <table class="tbl">
    <thead><tr><th>Nama Layanan</th><th>Tarif</th><th>Keterangan</th><th></th></tr></thead>
    <tbody>
      <% list.forEach(item => { %>
      <tr>
        <td><%= item.nama_layanan %></td>
        <td>Rp <%= Number(item.tarif).toLocaleString('id-ID') %></td>
        <td><%= item.keterangan %></td>
        <td class="whitespace-nowrap">
          <% if (['superadmin','petugas'].includes(currentUser.role)) { %>
          <a href="/jenis-layanan/<%= item.id %>/edit" class="text-blue-600 text-xs mr-3">Edit</a>
          <% } %>
          <% if (currentUser.role === 'superadmin') { %>
          <form action="/jenis-layanan/<%= item.id %>/hapus" method="POST" class="inline" onsubmit="return confirm('Hapus jenis layanan ini?')">
            <button class="text-red-600 text-xs">Hapus</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (list.length === 0) { %><tr><td colspan="4" class="text-center text-slate-400 py-4">Belum ada data</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
